{
  "name": "cccDataImporter",
  "private": true,
  "version": "1.0.0",
  "repository": "https://github.com/clockcrockwork/cccDataImporter",
  "author": "clockcrockwork",
  "workspaces": [
    "packages/*"
  ],
  "dependencies": {
    "@types/jest": "^29.5.12",
    "dotenv": "^16.4.5",
    "html-to-text": "^9.0.5",
    "node-fetch": "^3.3.2",
    "rss-parser": "^3.13.0"
  },
  "scripts": {
    "test": "node --test tests/*.test.cjs && node --experimental-vm-modules node_modules/jest/bin/jest.js --runInBand",
    "test:aliceBlogChecker": "node --experimental-vm-modules node_modules/jest/bin/jest.js --runInBand --runTestsByPath packages/aliceBlogChecker/tests/index.test.js",
    "test:common": "node --experimental-vm-modules node_modules/jest/bin/jest.js --runInBand --runTestsByPath packages/common/tests/errorHandler.test.js packages/common/tests/httpClient.test.js",
    "test:getPopularProducts": "node --experimental-vm-modules node_modules/jest/bin/jest.js --runInBand --runTestsByPath packages/getPopularProducts/tests/index.test.js",
    "test:getPopularRepositories": "node --experimental-vm-modules node_modules/jest/bin/jest.js --runInBand --runTestsByPath packages/getPopularRepositories/tests/index.test.js",
    "upgrade": "yarn workspaces foreach run upgrade-interactive --latest && yarn dedupe && yarn install",
    "upgrade-security": "yarn workspaces foreach run upgrade-interactive --latest --pattern '\\bvulnerable\\b' && yarn dedupe && yarn install",
    "license-check": "yarn workspaces foreach run license-checker --summary --production --failOn",
    "license-output": "license-checker --summary --production --json > license/licenses-root.json && yarn workspaces run license-checker --summary --production --json > license/licenses-packages.json",
    "test:dependencies": "node --test tests/*.test.cjs"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "lerna": "^9.0.7",
    "license-checker": "^25.0.1",
    "ts-jest": "^29.4.6"
  },
  "resolutions": {
    "tmp": "^0.2.4",
    "handlebars": "^4.7.9",
    "lodash": "^4.18.1",
    "@babel/helpers": "^7.26.10",
    "tar": "^7.5.13",
    "**/lerna/minimatch": "^3.1.5"
  },
  "packageManager": "yarn@1.22.22"
}
